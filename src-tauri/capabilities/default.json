{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "permissions": ["core:default", "dialog:default", "updater:default", "allow-desktop-exit"]
}
